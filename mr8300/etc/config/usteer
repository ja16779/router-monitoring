
config usteer
	option network 'lan'
	option syslog '0'
	option local_mode '0'
	option ipv6 '0'
	option debug_level '0'
	option signal_diff_threshold '2'
	option signal_connect '-75'
	option signal_kick '-82'
	option roam_process_timeout '5'
	option roam_scan_snr '15'
	option roam_scan_interval '10'
	option roam_trigger_snr '12'
	option min_connect_snr '15'
	option min_snr '10'
	option load_kick_enabled '1'
	option load_kick_threshold '75'
	option load_kick_delay '10000'
	option load_kick_min_clients '5'
	option band_steering_interval '120000'
	list ssid_list 'Mega_2.4G_A2DF'
	list ssid_list 'IOT'
	list ssid_list 'AXTEL XTREMO'
	list ssid_list 'Mega_5G_A2DF'

