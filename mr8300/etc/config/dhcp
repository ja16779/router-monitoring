
config dnsmasq
	option rebind_protection '1'
	option local '/lan/'
	option domain 'lan'
	option nonegcache '1'
	option authoritative '1'
	option readethers '1'
	option leasefile '/tmp/dhcp.leases'
	option localservice '0'
	option ednspacket_max '1232'
	option filter_aaaa '1'
	option sequential_ip '1'
	option quietdhcp '1'
	option dnsforwardmax '150'
	option dhcpleasemax '300'
	option logqueries '1'
	option cache_rr 'ANY'
	option localuse '0'
	option noresolv '1'
	option logfacility '/tmp/dnsmasq.log'
	list interface 'IOT'
	list interface 'lan'
	option cachesize_old '0'
	list server '127.0.0.1#3053'

config dhcp 'lan'
	option interface 'lan'
	option start '100'
	option limit '150'
	option leasetime '72h'
	option dhcpv4 'server'
	option force '1'
	option preferred_lifetime '48h'
	option ra_useleasetime '1'
	option dhcp_option '42,192.168.10.1'

config dhcp 'wan'
	option interface 'wan'
	option ignore '1'

config odhcpd 'odhcpd'
	option maindhcp '0'
	option leasefile '/tmp/odhcpd.leases'
	option leasetrigger '/usr/sbin/odhcpd-update'
	option loglevel '4'
	option piodir '/tmp/odhcpd-piodir'
	option hostsdir '/tmp/hosts'

config dhcp 'IOT'
	option interface 'IOT'
	option start '100'
	option limit '150'
	option leasetime '72h'
	list dhcp_option '42,192.168.8.1'

config dhcp 'guest'
