
config globals 'globals'
	option mmx_mask '0x3F00'
	list rt_table_lookup '220'
	option logging '1'
	option loglevel 'notice'

config interface 'wan'
	option family 'ipv4'
	option reliability '1'
	option initial_state 'online'
	option track_method 'ping'
	option count '3'
	option size '56'
	option max_ttl '60'
	option timeout '4'
	option interval '3'
	option failure_interval '5'
	option recovery_interval '5'
	option down '5'
	option up '5'
	option enabled '1'
	option keep_failure_interval '1'
	list track_ip '8.8.8.8'
	list track_ip '1.1.1.1'

config member 'wan_m1_w3'
	option interface 'wan'
	option metric '1'
	option weight '3'

config member 'wan_m2_w3'
	option interface 'wan'
	option metric '2'
	option weight '3'

config member 'wanb_m1_w2'
	option interface 'secondwan'
	option metric '1'
	option weight '2'

config member 'wanb_m1_w3'
	option interface 'secondwan'
	option metric '1'
	option weight '3'

config member 'wanb_m2_w2'
	option interface 'secondwan'
	option metric '2'
	option weight '2'

config policy 'wan_only'
	list use_member 'wan_m1_w3'

config policy 'wanb_only'
	list use_member 'wanb_m1_w2'

config policy 'balanced'
	list use_member 'wan_bal'
	list use_member 'wanb_bal'

config policy 'wan_wanb'
	list use_member 'wan_m1_w3'
	list use_member 'wanb_m2_w2'

config policy 'wanb_wan'
	list use_member 'wan_m2_w3'
	list use_member 'wanb_m1_w2'

config rule 'Citi'
	option family 'ipv4'
	option proto 'all'
	option src_ip '0.0.0.0/0'
	option dest_ip '192.193.0.0/16'
	option sticky '1'
	option timeout '600'
	option use_policy 'balanced'

config rule 'Mega_DNS'
	option family 'ipv4'
	option proto 'all'
	option dest_ip '8.8.4.4'
	option sticky '0'
	option use_policy 'wanb_only'

config rule 'DNS'
	option family 'ipv4'
	option proto 'all'
	option sticky '0'
	option ipset 'dns_servers'
	option use_policy 'wan_wanb'

config rule 'Beryl'
	option proto 'all'
	option src_ip '192.168.10.2'
	option sticky '0'
	option use_policy 'wanb_wan'
	option family 'ipv4'

config rule 'Glcloud'
	option family 'ipv4'
	option proto 'all'
	option sticky '0'
	option ipset 'glcloud'
	option use_policy 'wanb_wan'

config rule 'IOT'
	option family 'ipv4'
	option proto 'all'
	option src_ip '192.168.8.0/24'
	option dest_ip '0.0.0.0/0'
	option sticky '1'
	option use_policy 'wanb_wan'
	option timeout '600'

config rule 'Normal'
	option proto 'all'
	option src_ip '192.168.10.0/24'
	option dest_ip '0.0.0.0/0'
	option sticky '1'
	option use_policy 'balanced'
	option timeout '600'
	option family 'ipv4'

config rule 'wgserver'
	option family 'ipv4'
	option proto 'all'
	option src_ip '10.0.0.0/24'
	option dest_ip '0.0.0.0/0'
	option sticky '0'
	option use_policy 'wan_wanb'

config rule 'papertrail'
	option family 'ipv4'
	option proto 'udp'
	option sticky '1'
	option use_policy 'wanb_wan'
	option src_ip '0.0.0.0/0'
	option dest_ip '0.0.0.0/0'
	option dest_port '52356'

config rule 'Mega'
	option proto 'all'
	option src_ip '192.168.100.0/24'
	option dest_ip '0.0.0.0/0'
	option sticky '0'
	option use_policy 'wanb_only'
	option family 'ipv4'

config interface 'secondwan'
	option initial_state 'online'
	option family 'ipv4'
	option track_method 'ping'
	option reliability '1'
	option count '3'
	option size '56'
	option max_ttl '60'
	option timeout '4'
	option interval '3'
	option failure_interval '5'
	option recovery_interval '5'
	option down '5'
	option up '5'
	option enabled '1'
	option keep_failure_interval '1'
	list track_ip '8.8.4.4'
	list track_ip '1.0.0.1'

config member 'wan_bal'
	option interface 'wan'
	option metric '1'
	option weight '25'

config member 'wanb_bal'
	option interface 'secondwan'
	option metric '1'
	option weight '11'

config rule 'default_rule_v4'
	option dest_ip '0.0.0.0/0'
	option use_policy 'balanced'
	option family 'ipv4'
	option proto 'all'
	option sticky '1'
	option src_ip '0.0.0.0/0'
	option timeout '3600'

