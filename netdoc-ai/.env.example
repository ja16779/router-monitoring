# ─────────────────────────────────────────────────────────────────────────────
# netdoc-ai :: Environment Configuration
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=mistral:7b
OLLAMA_TIMEOUT=300
OLLAMA_CONTEXT=8192

# ── Security ──────────────────────────────────────────────────────────────────
# Change this before production use!
API_KEY=changeme-local-poc
# Comma-separated allowed IPs (127.0.0.1 = localhost only)
ALLOWED_IPS=127.0.0.1,::1

# ── Jump Host (leave blank if direct SSH to router) ───────────────────────────
JUMP_HOST=
JUMP_PORT=22
JUMP_USER=netops
JUMP_KEY_PATH=C:/Users/ja167/.ssh/jump_id_rsa
JUMP_PASSWORD=

# ── Router Credentials ────────────────────────────────────────────────────────
ROUTER_PORT=22
ROUTER_USER=readonly
ROUTER_KEY_PATH=C:/Users/ja167/.ssh/router_id_rsa
ROUTER_PASSWORD=
# Cisco enable password (leave blank if not needed or key-based)
ROUTER_ENABLE_PW=

# ── Timeouts ──────────────────────────────────────────────────────────────────
SSH_TIMEOUT=30
SSH_BANNER_TIMEOUT=15
CMD_TIMEOUT=60
